!.env.example
!infra/.env.example

# Secret / credential files
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12
secrets.*
credentials.*
*.secret
aws-credentials
service-account*.json
*-service-account.json

# ===== Database (local dev data — never commit) =====
.mariadb/
*.db
*.sqlite
*.sqlite3
*.ibd
*.frm
*.sql
# Keep the schema (not data) so the backend can provision its tables.
!infra/mysql/init/001_schema.sql

