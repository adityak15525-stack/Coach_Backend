# ---- Stage 1: build the Expo web export ----
FROM node:20-bookworm-slim AS web-builder

WORKDIR /repo

# Install root workspace deps first (cached layer)
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/compute/package.json packages/compute/package.json
COPY packages/dsa/package.json packages/dsa/package.json
COPY frontend/mobile/package.json frontend/mobile/package.json
RUN npm ci --no-audit --no-fund

# Copy sources (metro watchFolders includes the monorepo root)
COPY packages/ packages/
COPY apps/ apps/
COPY frontend/ frontend/

WORKDIR /repo/frontend/mobile

# Production API URLs: same-origin, nginx rewrites /api/* and /live-session
ENV EXPO_PUBLIC_API_URL=/api
ENV EXPO_PUBLIC_WS_URL=/live-session
ENV CI=1
RUN npx expo export --platform web --output-dir dist

# ---- Stage 2: serve the static build with nginx ----
FROM nginx:1.27-alpine

COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /repo/frontend/mobile/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
