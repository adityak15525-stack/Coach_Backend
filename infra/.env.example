# ---- NEURAL COACH deployment config ----
# Copy to `.env` and edit. Used by: infra/docker-compose.yml

# Database
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=ai_coach
DB_USER=ai_coach
DB_PASSWORD=change-me-db

# Auth signing secret — MUST be a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# ElevenLabs TTS voice coach (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=0.9

# SMTP — welcome emails. Empty SMTP_* → emails logged to API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
MAIL_FROM=Neural Coach <no-reply@neuralcoach.app>
