# ---- API ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-prod

# ---- MySQL ----
# Option A: individual fields
DB_HOST=localhost
DB_PORT=3306
DB_USER=ai_coach
DB_PASSWORD=ai_coach
DB_NAME=ai_coach
# Option B: full connection string (TiDB Serverless). When set, it overrides
# the individual fields above. Requires TLS as well:
# DATABASE_URL=mysql://<user>:<password>@<host>.prod.aws.tidbcloud.com:4000/<db>
# DB_SSL=true
# DB_SSL_CA=/optional/path/to/ca.pem

# ---- Agents (Python) ----
AGENTS_URL=http://localhost:8000

# ---- GenAI ----
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ---- Email (welcome emails on register; leave blank → dev-log mode) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
MAIL_FROM=Neural Coach <no-reply@neuralcoach.app>
